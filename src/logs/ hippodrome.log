<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Папка для логов -->
    <property name="LOG_DIR" value="./logs" />
    <property name="LOG_FILE" value="hippodrome.log" />

    <!-- Аппендер для записи в файл с ротацией -->
    <appender name="ROLLING_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- Текущий файл -->
        <file>${LOG_DIR}/${LOG_FILE}</file>

        <!-- Политика ротации -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Шаблон для архивных файлов -->
            <fileNamePattern>${LOG_DIR}/hippodrome.%d{yyyy-MM-dd}.log</fileNamePattern>

            <!-- Хранить логи 7 дней -->
            <maxHistory>7</maxHistory>

            <!-- Удаление старых файлов -->
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>

        <!-- Энкодер с форматом -->
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss,SSS} %-5level %logger{36}: %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Конфигурация логирования -->
    <logger name="Horse" level="DEBUG" />
    <logger name="Hippodrome" level="DEBUG" />

    <root level="INFO">
        <appender-ref ref="ROLLING_FILE" />
    </root>
</configuration>